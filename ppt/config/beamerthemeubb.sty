% =====================================================================
% beamerthemeubb.sty
% Tema Beamer bersama untuk 14 deck Teknik Kompilasi.
% Warna mengikuti buku ajar: ubbblue, ubbteal, ubbgold.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeubb}[2026/10/29 Tema UBB Teknik Kompilasi]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[indonesian]{babel}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{listings}
\RequirePackage{tikz}
\RequirePackage{amsmath}
\RequirePackage{graphicx}

\usetikzlibrary{positioning,arrows.meta,calc,shapes.geometric,decorations.pathreplacing}

% ---------------------------------------------------------------- warna
\definecolor{ubbblue}{RGB}{15,55,110}
\definecolor{ubbteal}{RGB}{0,120,130}
\definecolor{ubbgold}{RGB}{200,150,40}
\definecolor{ubbink}{RGB}{35,40,48}
\definecolor{ubbmist}{RGB}{244,246,249}

% ------------------------------------------------------------- identitas
% Nomor pertemuan diatur oleh setiap deck: \UBBmeeting{1}
\def\ubbmeeting{1}
\newcommand{\UBBmeeting}[1]{\def\ubbmeeting{#1}}

% ------------------------------------------------------------- tampilan
\usefonttheme[onlymath]{serif}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=0.7cm,text margin right=0.7cm}
\setbeamercolor{normal text}{fg=ubbink,bg=white}
\setbeamercolor{structure}{fg=ubbblue}
\setbeamerfont{normal text}{size=\small}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\footnotesize,series=\mdseries}

% ------------------------------------------------------------ frametitle
\setbeamercolor{frametitle}{fg=white,bg=ubbblue}
\setbeamertemplate{frametitle}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[ubbblue] (current page.north west) rectangle
      ([yshift=-1.04cm]current page.north east);
    \fill[ubbgold] ([yshift=-1.04cm]current page.north west) rectangle
      ([yshift=-1.09cm]current page.north east);
  \end{tikzpicture}%
  \vspace{0.04cm}%
  \hbox to \textwidth{%
    \usebeamerfont{frametitle}\color{white}\insertframetitle\hfil}%
  \vspace{0.30cm}%
}

% ---------------------------------------------------------------- footer
\setbeamercolor{footline}{fg=ubbblue,bg=ubbmist}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.76\paperwidth,ht=0.34cm,dp=0.15cm,leftskip=0.70cm]{footline}%
      \usebeamerfont{footline}%
      Teknik Kompilasi\ \textperiodcentered\ MWCA017\ \textperiodcentered\ Pertemuan \ubbmeeting%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.24\paperwidth,ht=0.34cm,dp=0.15cm,rightskip=0.70cm]{footline}%
      \hfill\usebeamerfont{footline}\insertframenumber%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

% ------------------------------------------------------------ itemize
\setbeamercolor{itemize item}{fg=ubbgold}
\setbeamercolor{itemize subitem}{fg=ubbteal}
\setbeamercolor{itemize subsubitem}{fg=ubbblue}
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\scriptsize\textbullet}}
\setbeamertemplate{itemize subitem}{\raisebox{0.35ex}{\tiny\textbullet}}
\setbeamertemplate{itemize subsubitem}{\raisebox{0.35ex}{\tiny$\circ$}}
\setbeamercolor{enumerate item}{fg=ubbblue}
\setbeamercolor{enumerate subitem}{fg=ubbteal}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\insertenumlabel.}

% --------------------------------------------------------------- blocks
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamercolor{block title}{bg=ubbblue,fg=white}
\setbeamercolor{block body}{bg=ubbblue!6,fg=ubbink}
\setbeamercolor{block title alerted}{bg=ubbteal,fg=white}
\setbeamercolor{block body alerted}{bg=ubbteal!7,fg=ubbink}
\setbeamercolor{block title example}{bg=ubbgold,fg=ubbblue}
\setbeamercolor{block body example}{bg=ubbgold!12,fg=ubbink}
\setbeamerfont{block title}{size=\small,series=\bfseries}

% ------------------------------------------------------------- listings
\lstdefinestyle{ubbcode}{%
  basicstyle=\ttfamily\scriptsize,
  keywordstyle=\color{ubbblue}\bfseries,
  commentstyle=\color{ubbteal}\itshape,
  stringstyle=\color{ubbgold!85!black},
  numberstyle=\tiny\color{ubbblue!60},
  numbers=left,
  numbersep=5pt,
  frame=single,
  rulecolor=\color{ubbblue!25},
  backgroundcolor=\color{ubbmist},
  showstringspaces=false,
  breaklines=true,
  tabsize=4,
  xleftmargin=1.1em,
  framexleftmargin=0.6em,
  aboveskip=3pt,
  belowskip=2pt,
  captionpos=b,
}
\lstset{style=ubbcode,language=C}

\lstdefinelanguage{Flex}{%
  morekeywords={%%
    %option,include,define,ifdef,ifndef,endif,else,elif,%
    BEGIN,ECHO,REJECT,yytext,yyleng,yylineno,yywrap,%
    yyin,yyout,YY_DECL,YY_BUFFER_STATE,yy_scan_string,%
    yy_scan_bytes,yy_delete_buffer,unput,input,START},%
  sensitive=true,%
  morecomment=[s]{/*}{*/},%
  morestring=[b]"%
}
\lstdefinelanguage{Bison}{%
  morekeywords={%%
    token,type,union,left,right,nonassoc,start,expect,%
    precedence,locations,debug,pure,parse-param,lex-param,%
    error,YYSTYPE,YYLTYPE,yylex,yyerror,yylval,yylloc},%
  sensitive=true,%
  morecomment=[s]{/*}{*/},%
  morecomment=[l]{//},%
  morestring=[b]"%
}
\lstdefinelanguage{EBNF}{%
  sensitive=true,%
  morecomment=[l]{//},%
  morestring=[b]"%
}

% --------------------------------------------------- rantai proyek (TikZ)
% \UBBchain{0} menyorot seluruh rantai; 1--6 menyorot satu tahap.
\newcommand{\UBBst}[1]{%
  \ifnum\UBBact=0 active\else\ifnum\UBBact=#1\space active\else stage\fi\fi}
\newcommand{\UBBchain}[1]{%
  \def\UBBact{#1}%
  \begin{center}%
  \begin{tikzpicture}[
      stage/.style={draw=ubbblue!35,fill=ubbblue!6,rounded corners=3pt,
        minimum width=2.05cm,minimum height=1.02cm,align=center,
        font=\scriptsize\bfseries,text=ubbblue,inner sep=2pt},
      active/.style={stage,draw=ubbgold,fill=ubbgold!24,line width=1.2pt},
      arr/.style={-{Stealth[length=1.7mm]},draw=ubbblue!45,line width=0.7pt}
    ]
    \node[\UBBst{1}] (n1) {Lexer};
    \node[\UBBst{2},right=0.26cm of n1] (n2) {Grammar};
    \node[\UBBst{3},right=0.26cm of n2] (n3) {Parser};
    \node[\UBBst{4},right=0.26cm of n3] (n4) {Semantik};
    \node[\UBBst{5},right=0.26cm of n4] (n5) {Symbol table};
    \node[\UBBst{6},right=0.26cm of n5] (n6) {AST};
    \foreach \a/\b in {n1/n2,n2/n3,n3/n4,n4/n5,n5/n6}{
      \draw[arr] (\a) -- (\b);
    }
  \end{tikzpicture}%
  \end{center}%
}

% ----------------------------------------------------------- halaman judul
% \UBBtitleframe{nomor}{topik}{jenis pertemuan}
\newcommand{\UBBtitleframe}[3]{%
  \begin{frame}%
    \begin{tikzpicture}[remember picture,overlay]
      \fill[ubbblue] (current page.north west) rectangle ([yshift=-4.55cm]current page.north east);
      \fill[ubbteal] ([yshift=-4.55cm]current page.north west) rectangle ([yshift=-4.77cm]current page.north east);
      \fill[ubbgold] ([yshift=-4.55cm]current page.north west) rectangle ([yshift=-4.77cm,xshift=3.6cm]current page.north west);
      \fill[ubbgold] ([xshift=0.38cm,yshift=-0.62cm]current page.north west) rectangle ([xshift=0.52cm,yshift=-4.20cm]current page.north west);
      \node[anchor=north west,align=left,inner sep=0pt,text width=14.0cm]
        at ([xshift=0.78cm,yshift=-0.50cm]current page.north west) {%
          {\color{ubbgold}\sffamily\bfseries\small PERTEMUAN #1\ \ \textperiodcentered\ \ #3}\\[0.24cm]
          {\color{white}\sffamily\bfseries\fontsize{20.74}{24.9}\selectfont #2}%
        };
      \node[anchor=south west,align=left,inner sep=0pt,text width=14.0cm]
        at ([xshift=0.78cm,yshift=0.78cm]current page.south west) {%
          {\color{ubbblue}\sffamily\bfseries\small Universitas Bale Bandung}\\[0.05cm]
          {\color{ubbblue!80}\sffamily\scriptsize Fakultas Teknologi Informasi\ \textperiodcentered\ Program Studi Teknik Informatika}\\[0.03cm]
          {\color{ubbblue!80}\sffamily\scriptsize Mata Kuliah Teknik Kompilasi (MWCA017)\ \textperiodcentered\ Semester Ganjil\ \textperiodcentered\ 3 SKS}\\[0.03cm]
          {\color{ubbblue!80}\sffamily\scriptsize Dosen: Cecep Suwanda, S.Si., M.Kom.}%
        };
    \end{tikzpicture}%
    \null
  \end{frame}%
}

